# ========================================================
# GrandStay Hotel Management System - Environment Config
# ========================================================
# Copy this file to '.env' and adjust your MySQL credentials.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=grandstay-super-secret-key-change-in-production-2026

# MySQL Database Configuration
# Default XAMPP / WampServer user is 'root' with empty password ''
# If using MySQL Installer or Workbench, enter your root password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=hotel_management

# Hotel Branding & Details
HOTEL_NAME=GrandStay Hotel & Suites
HOTEL_TAGLINE=Smart Hotel Booking, Room Availability and Billing Management
HOTEL_PHONE=+1 (800) 555-4726
HOTEL_EMAIL=reservations@grandstayhotel.com
HOTEL_ADDRESS=742 Evergreen Promenade, Suite 100, Metropolitan City
HOTEL_CURRENCY=$
HOTEL_TAX_RATE=0.10
